# 应用配置
APP_NAME=SuperBizAgent
DEBUG=True
HOST=0.0.0.0
PORT=9900

# LLM 提供商类型: "dashscope" (阿里云/硅基流动) 或 "openai"
LLM_PROVIDER=openai

# DashScope 配置 (当 LLM_PROVIDER="dashscope" 时使用)
DASHSCOPE_API_KEY=sk-ctqzhwwosissprjawdlpqnrveejmozxissegxggwiklixrpu
DASHSCOPE_API_BASE=https://api.siliconflow.cn/v1/
DASHSCOPE_MODEL=MiniMaxAI/MiniMax-M2.5
DASHSCOPE_EMBEDDING_MODEL=text-embedding-v4

# OpenAI 配置 (当 LLM_PROVIDER="openai" 时使用)
# 使用硅基流动的 API Key 和地址（OpenAI 兼容模式）
OPENAI_API_KEY=sk-ctqzhwwosissprjawdlpqnrveejmozxissegxggwiklixrpu
OPENAI_API_BASE=https://api.siliconflow.cn/v1
OPENAI_MODEL=MiniMaxAI/MiniMax-M2.5
OPENAI_EMBEDDING_MODEL=text-embedding-v4

# Milvus 配置
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_TIMEOUT=10000

# RAG 配置
RAG_TOP_K=3
RAG_MODEL=gpt-4o

# 文档分块配置
CHUNK_MAX_SIZE=800
CHUNK_OVERLAP=100

# MCP 服务配置
# 支持的 transport 类型：stdio、sse（腾讯云等 /sse/ 端点）、streamable-http（本地 FastMCP）
# 也可以配置真实的cls mcp服务： https://cloud.tencent.com/developer/mcp/server/11710
MCP_CLS_TRANSPORT=sse
MCP_CLS_URL=https://mcp-api.tencent-cloud.com/sse/xxxx
MCP_CLS_TRANSPORT=streamable-http
MCP_CLS_URL=http://localhost:8003/mcp
MCP_MONITOR_TRANSPORT=streamable-http
MCP_MONITOR_URL=http://localhost:8004/mcp

# Prometheus（告警查询工具等）
PROMETHEUS_BASE_URL=http://127.0.0.1:9090
PROMETHEUS_REQUEST_TIMEOUT=10.0
